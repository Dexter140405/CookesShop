@model IEnumerable<CookesShop.Web.Models.Promotion>
@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
}

<div class="card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách Khuyến mãi</h5>
        <a asp-action="Create" class="btn btn-primary">Thêm mới</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-3">Mã code</th>
                        <th>Giảm giá (%)</th>
                        <th>Giảm tối đa</th>
                        <th>Ngày hết hạn</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-3 fw-bold">@item.Code</td>
                            <td>@item.DiscountPercentage %</td>
                            <td>@(item.MaxDiscountAmount?.ToString("N0") ?? "Không giới hạn") đ</td>
                            <td>@item.ExpiryDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.IsActive && item.ExpiryDate > DateTime.UtcNow)
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hạn / Khóa</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
