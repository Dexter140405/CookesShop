@model IEnumerable<CookesShop.Web.Models.Order>
@{
    ViewData["Title"] = "Tổng quan thống kê";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">DOANH THU HÔM NAY</h6>
                        <h3 class="mb-0">@((ViewBag.RevenueToday ?? 0).ToString("N0")) đ</h3>
                    </div>
                    <div class="fs-1 text-white-50"><i class="fa-solid fa-money-bill-trend-up"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-dark-50">ĐƠN CHỜ XỬ LÝ</h6>
                        <h3 class="mb-0">@ViewBag.PendingOrders</h3>
                    </div>
                    <div class="fs-1 text-dark-50"><i class="fa-solid fa-clock"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">SẢN PHẨM TRONG KHO</h6>
                        <h3 class="mb-0">@ViewBag.TotalProducts</h3>
                    </div>
                    <div class="fs-1 text-white-50"><i class="fa-solid fa-box-open"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">KHÁCH HÀNG</h6>
                        <h3 class="mb-0">@ViewBag.TotalUsers</h3>
                    </div>
                    <div class="fs-1 text-white-50"><i class="fa-solid fa-users"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Đơn hàng gần đây</h5>
                <a href="/Admin/Orders" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="px-3">Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="px-3 fw-bold">#@order.Id.ToString("D5")</td>
                                    <td>@order.User?.FullName</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@order.TotalAmount.ToString("N0") đ</td>
                                    <td>
                                        @{
                                            var bgClass = "bg-secondary";
                                            switch (order.Status)
                                            {
                                                case "Pending": bgClass = "bg-warning text-dark"; break;
                                                case "Delivering": bgClass = "bg-primary"; break;
                                                case "Completed": bgClass = "bg-success"; break;
                                            }
                                        }
                                        <span class="badge @bgClass">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <!-- Revenue chart placeholder -->
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Doanh thu tuần này</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div class="text-center text-muted">
                    <i class="fa-solid fa-chart-line fs-1 mb-3"></i>
                    <p>Biểu đồ doanh thu</p>
                </div>
            </div>
        </div>
    </div>
</div>
