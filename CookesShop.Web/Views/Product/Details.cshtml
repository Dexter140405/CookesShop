@model CookesShop.Web.Models.Product
@{
    ViewData["Title"] = Model.Name;
    var relatedProducts = ViewBag.RelatedProducts as List<CookesShop.Web.Models.Product>;
}

<div class="row mb-5">
    <!-- Product Images -->
    <div class="col-md-6 mb-4 mb-md-0">
        <div class="card border-0 rounded-4 overflow-hidden shadow-sm">
            <div class="d-flex align-items-center justify-content-center p-0" style="background-color: #f8f9fa; height: 400px;">
                @if (string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <i class="fa-solid fa-cake-candles" style="font-size: 8rem; color: var(--color-butter);"></i>
                }
                else
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" style="width: 100%; height: 100%; object-fit: cover;" />
                }
            </div>
            @if (Model.IsHot)
            {
                <span class="badge bg-danger position-absolute top-0 start-0 m-3 fs-6 rounded-pill">HOT</span>
            }
        </div>
    </div>

    <!-- Product Info -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none" style="color: var(--color-chocolate);">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product" class="text-decoration-none" style="color: var(--color-chocolate);">Sản phẩm</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Category?.Name</li>
            </ol>
        </nav>

        <h1 class="display-5 fw-bold mb-3" style="color: var(--color-chocolate);">@Model.Name</h1>
        
        <div class="d-flex align-items-center mb-3">
            <div class="text-warning me-2">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star-half-stroke"></i>
            </div>
            <span class="text-muted">(4.5 / 5 đánh giá)</span>
        </div>

        <h2 class="mb-4" style="color: var(--color-chocolate); font-weight: 700;">@Model.Price.ToString("N0") đ</h2>

        <p class="lead mb-4">@Model.Description</p>

        @if (!string.IsNullOrEmpty(Model.Ingredients))
        {
            <div class="mb-4 p-3 rounded-4" style="background-color: var(--color-cream); border: 1px dashed var(--color-butter);">
                <h6 style="color: var(--color-chocolate);"><i class="fa-solid fa-leaf me-2"></i>Thành phần nguyên liệu:</h6>
                <p class="mb-0 text-muted small">@Model.Ingredients</p>
            </div>
        }

        <div class="d-flex align-items-center mb-4">
            <div class="me-3">
                <span class="text-muted">Tình trạng: </span>
                @if (Model.StockQuantity > 0)
                {
                    <span class="badge bg-success rounded-pill">Còn hàng (@Model.StockQuantity)</span>
                }
                else
                {
                    <span class="badge bg-danger rounded-pill">Cháy hàng</span>
                }
            </div>
        </div>

        <div class="d-flex gap-3">
            <div class="input-group" style="width: 130px;">
                <button class="btn btn-outline-secondary rounded-start-pill px-3" type="button" id="btn-minus"><i class="fa-solid fa-minus"></i></button>
                <input type="text" class="form-control text-center border-secondary" id="quantity" value="1" readonly>
                <button class="btn btn-outline-secondary rounded-end-pill px-3" type="button" id="btn-plus"><i class="fa-solid fa-plus"></i></button>
            </div>
            
            <button type="button" class="btn btn-primary flex-grow-1" id="btn-add-cart-detail" data-id="@Model.Id" @(Model.StockQuantity <= 0 ? "disabled" : "")>
                <i class="fa-solid fa-cart-plus me-2"></i> Thêm vào giỏ hàng
            </button>
        </div>
    </div>
</div>

<!-- Tabs for Reviews & Q&A -->
<div class="row mb-5">
    <div class="col-12">
        <ul class="nav nav-pills mb-4" id="product-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4" id="reviews-tab" data-bs-toggle="pill" data-bs-target="#reviews" type="button" role="tab" style="font-weight: 600;">Đánh giá (@Model.Reviews.Count)</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 mx-2" id="qa-tab" data-bs-toggle="pill" data-bs-target="#qa" type="button" role="tab" style="color: var(--color-chocolate); font-weight: 600;">Hỏi đáp</button>
            </li>
        </ul>
        
        <div class="tab-content bg-white p-4 rounded-4 shadow-sm" id="product-tabContent">
            <!-- Reviews Tab -->
            <div class="tab-pane fade show active" id="reviews" role="tabpanel">
                <h4 class="mb-4" style="color: var(--color-chocolate);">Đánh giá từ khách hàng</h4>
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews.Where(r => r.IsApproved))
                    {
                        <div class="d-flex mb-4 pb-4 border-bottom">
                            <div class="flex-shrink-0">
                                <div style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--color-butter); display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--color-chocolate);">
                                    @(review.User?.FullName?.Substring(0,1) ?? "U")
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">@review.User?.FullName <small class="text-muted fw-normal ms-2">@review.CreatedAt.ToString("dd/MM/yyyy")</small></h6>
                                <div class="text-warning mb-2" style="font-size: 0.8rem;">
                                    @for(int i=0; i<review.Rating; i++) { <i class="fa-solid fa-star"></i> }
                                </div>
                                <p class="mb-0">@review.Comment</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên!</p>
                }
                
                <hr />
                <h5 class="mt-4">Viết đánh giá của bạn</h5>
                <!-- Form for new review (would require authentication) -->
                <p class="text-muted small">Vui lòng <a href="/Account/Login">đăng nhập</a> để viết đánh giá.</p>
            </div>
            
            <!-- Q&A Tab -->
            <div class="tab-pane fade" id="qa" role="tabpanel">
                <h4 class="mb-4" style="color: var(--color-chocolate);">Câu hỏi thường gặp</h4>
                <div class="accordion accordion-flush" id="accordionQA">
                  <div class="accordion-item">
                    <h2 class="accordion-header">
                      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#qa1">
                        Bánh bảo quản được bao lâu?
                      </button>
                    </h2>
                    <div id="qa1" class="accordion-collapse collapse" data-bs-parent="#accordionQA">
                      <div class="accordion-body text-muted">Bánh tươi của CookesShop được làm trong ngày, ngon nhất khi dùng trong vòng 24h. Nếu bảo quản lạnh, có thể giữ được 2-3 ngày tùy loại bánh.</div>
                    </div>
                  </div>
                </div>
                <div class="mt-4">
                    <h5>Bạn có câu hỏi khác?</h5>
                    <a asp-controller="Support" asp-action="Index" class="btn btn-outline-primary rounded-pill mt-2">Liên hệ chúng tôi</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Related Products -->
@if (relatedProducts != null && relatedProducts.Any())
{
    <div class="mb-5">
        <h3 class="mb-4" style="color: var(--color-chocolate);"><i class="fa-solid fa-heart text-danger me-2"></i> Có thể bạn sẽ thích</h3>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @foreach (var item in relatedProducts)
            {
                <div class="col">
                    <div class="card h-100 product-card">
                        <a href="@Url.Action("Details", new { slug = item.Slug })" class="text-decoration-none text-dark">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top d-flex align-items-center justify-content-center" style="background-color: #f8f9fa; height: 200px;">
                                    <i class="fa-solid fa-cookie" style="font-size: 3rem; color: #ccc;"></i>
                                </div>
                            }
                            <div class="card-body">
                                <h6 class="card-title text-truncate">@item.Name</h6>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="product-price fs-6">@item.Price.ToString("N0") đ</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#btn-plus').click(function() {
                var val = parseInt($('#quantity').val());
                if(val < @Model.StockQuantity) {
                    $('#quantity').val(val + 1);
                }
            });
            $('#btn-minus').click(function() {
                var val = parseInt($('#quantity').val());
                if(val > 1) {
                    $('#quantity').val(val - 1);
                }
            });
        });
    </script>
}
