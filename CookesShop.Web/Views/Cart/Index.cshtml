@model IEnumerable<CookesShop.Web.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    decimal total = Model?.Sum(x => x.Quantity * x.Product!.Price) ?? 0;
}

<div class="row mb-5">
    <div class="col-12">
        <h2 class="mb-4" style="color: var(--color-chocolate);"><i class="fa-solid fa-cart-shopping me-2"></i> Giỏ hàng của bạn</h2>
        
        @if (Model != null && Model.Any())
        {
            <div class="row">
                <div class="col-lg-8 mb-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="border-0 text-muted">Sản phẩm</th>
                                            <th scope="col" class="border-0 text-muted">Đơn giá</th>
                                            <th scope="col" class="border-0 text-muted">Số lượng</th>
                                            <th scope="col" class="border-0 text-muted">Thành tiền</th>
                                            <th scope="col" class="border-0"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="flex-shrink-0" style="width: 60px; height: 60px; background-color: #f8f9fa; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fa-solid fa-cookie fs-3 text-muted"></i>
                                                        </div>
                                                        <div class="flex-grow-1 ms-3">
                                                            <a href="/Product/Details/@item.Product?.Slug" class="text-decoration-none text-dark fw-bold">@item.Product?.Name</a>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@item.Product?.Price.ToString("N0") đ</td>
                                                <td>
                                                    <form method="post" asp-action="UpdateQuantity" class="d-flex align-items-center">
                                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                                        <input type="number" name="quantity" class="form-control form-control-sm text-center me-2" value="@item.Quantity" min="1" max="@item.Product?.StockQuantity" style="width: 60px;" onchange="this.form.submit()">
                                                    </form>
                                                </td>
                                                <td class="fw-bold" style="color: var(--color-chocolate);">@((item.Quantity * item.Product!.Price).ToString("N0")) đ</td>
                                                <td>
                                                    <form method="post" asp-action="Remove">
                                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle"><i class="fa-solid fa-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4" style="background-color: var(--color-cream);">
                        <div class="card-body p-4">
                            <h5 class="card-title mb-4" style="color: var(--color-chocolate);">Tổng quan đơn hàng</h5>
                            
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Tạm tính:</span>
                                <span>@total.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Phí giao hàng:</span>
                                <span>Chưa tính</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-4">
                                <strong class="fs-5" style="color: var(--color-chocolate);">Tổng cộng:</strong>
                                <strong class="fs-5 text-danger">@total.ToString("N0") đ</strong>
                            </div>
                            
                            <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary w-100 py-2 fs-5">Tiến hành thanh toán</a>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-link text-decoration-none w-100 mt-2" style="color: var(--color-chocolate);">Tiếp tục mua sắm</a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="fa-solid fa-cart-arrow-down mb-3" style="font-size: 5rem; color: #ccc;"></i>
                <h4 class="text-muted">Giỏ hàng của bạn đang trống</h4>
                <p class="text-muted mb-4">Hãy lấp đầy giỏ hàng bằng những chiếc bánh thơm ngon nhé!</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2">Khám phá sản phẩm</a>
            </div>
        }
    </div>
</div>
