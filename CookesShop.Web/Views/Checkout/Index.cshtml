@model IEnumerable<CookesShop.Web.Models.CartItem>
@{
    ViewData["Title"] = "Thanh toán";
    decimal total = Model.Sum(x => x.Quantity * x.Product!.Price);
}

<div class="row mb-5">
    <div class="col-12">
        <h2 class="mb-4" style="color: var(--color-chocolate);"><i class="fa-solid fa-credit-card me-2"></i> Thanh toán</h2>
        
        <form method="post" asp-action="PlaceOrder" class="row">
            <div class="col-lg-7 mb-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="card-title mb-4" style="color: var(--color-chocolate);">Thông tin nhận hàng</h5>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted small">Họ và tên</label>
                            <input type="text" class="form-control rounded-3" name="fullName" value="@ViewBag.CurrentUser?.FullName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small">Số điện thoại</label>
                            <input type="text" class="form-control rounded-3" name="phoneNumber" value="@ViewBag.CurrentUser?.PhoneNumber" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small">Địa chỉ giao hàng</label>
                            <textarea class="form-control rounded-3" name="address" rows="2" required>@ViewBag.CurrentUser?.Address</textarea>
                        </div>
                        
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="card-title mb-4" style="color: var(--color-chocolate);">Phương thức thanh toán</h5>
                        
                        <div class="form-check mb-3 p-3 rounded-3 border" style="border-color: #dee2e6 !important;">
                            <input class="form-check-input ms-1" type="radio" name="paymentMethod" id="paymentCOD" value="COD" checked>
                            <label class="form-check-label ms-2 w-100 cursor-pointer d-flex align-items-center" for="paymentCOD">
                                <i class="fa-solid fa-money-bill-wave text-success fs-4 me-3"></i>
                                <div>
                                    <strong>Thanh toán khi nhận hàng (COD)</strong>
                                    <div class="text-muted small">Nhận hàng rồi mới thanh toán</div>
                                </div>
                            </label>
                        </div>

                        <div class="form-check p-3 rounded-3 border" style="border-color: #dee2e6 !important;">
                            <input class="form-check-input ms-1" type="radio" name="paymentMethod" id="paymentOnline" value="Online">
                            <label class="form-check-label ms-2 w-100 cursor-pointer d-flex align-items-center" for="paymentOnline">
                                <i class="fa-regular fa-credit-card text-primary fs-4 me-3"></i>
                                <div>
                                    <strong>Thanh toán trực tuyến (VNPay / Momo)</strong>
                                    <div class="text-muted small">Chuyển hướng đến cổng thanh toán bảo mật</div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4" style="background-color: var(--color-cream);">
                    <div class="card-body p-4">
                        <h5 class="card-title mb-4" style="color: var(--color-chocolate);">Tóm tắt đơn hàng</h5>
                        
                        <div class="mb-4">
                            @foreach (var item in Model)
                            {
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <div>
                                        <span class="text-dark fw-bold">@item.Quantity x</span> @item.Product?.Name
                                    </div>
                                    <span>@((item.Quantity * item.Product!.Price).ToString("N0")) đ</span>
                                </div>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted small">Mã khuyến mãi (Nếu có)</label>
                            <div class="input-group">
                                <input type="text" name="promotionCode" class="form-control" placeholder="Nhập mã..." style="border-radius: 20px 0 0 20px;">
                                <button class="btn btn-secondary" type="button" style="border-radius: 0 20px 20px 0;">Áp dụng</button>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span>@total.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Phí giao hàng:</span>
                            <span>Miễn phí</span> <!-- Simplified for demo -->
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4 align-items-center">
                            <strong class="fs-5" style="color: var(--color-chocolate);">Tổng cộng:</strong>
                            <strong class="fs-4 text-danger">@total.ToString("N0") đ</strong>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 py-3 fs-5 fw-bold" style="border-radius: 15px;">Xác nhận đặt hàng</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
