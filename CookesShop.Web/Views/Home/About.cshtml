@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-md-6 mb-4 mb-md-0">
            <h1 class="display-4 mb-4">Về Sweet & Warm Bakery</h1>
            <p class="lead">Chào mừng bạn đến với CookesShop - Nơi lan tỏa sự ngọt ngào!</p>
            <p>Được thành lập từ tình yêu với những chiếc bánh nướng, chúng tôi tự hào mang đến cho khách hàng những sản phẩm chất lượng nhất. Từng chiếc bánh được làm ra không chỉ bằng nguyên liệu tuyệt hảo mà còn bằng cả trái tim của những người thợ làm bánh lành nghề.</p>
            <p>Sứ mệnh của chúng tôi là tạo ra những khoảnh khắc hạnh phúc cho bạn và gia đình thông qua hương vị tuyệt vời của từng sản phẩm.</p>
            
            <div class="mt-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3 text-center" style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--color-butter); display: flex; align-items: center; justify-content: center; color: var(--color-chocolate);">
                        <i class="fa-solid fa-leaf fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">Nguyên liệu tự nhiên</h5>
                        <small class="text-muted">100% nguyên liệu sạch và an toàn.</small>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3 text-center" style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--color-butter); display: flex; align-items: center; justify-content: center; color: var(--color-chocolate);">
                        <i class="fa-solid fa-heart fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">Làm bằng tình yêu</h5>
                        <small class="text-muted">Mỗi chiếc bánh là một tác phẩm nghệ thuật.</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 text-center">
            <div class="p-5" style="background-color: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
                <i class="fa-solid fa-shop" style="font-size: 10rem; color: var(--color-butter);"></i>
            </div>
        </div>
    </div>
</div>
